{
	"name": "kids-tracker",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"generate-routes": "vite build",
		"build": "vite build",
		"preview": "pnpm run build && vite preview",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply kids-tracker --local",
		"db:migrate:remote": "wrangler d1 migrations apply kids-tracker --remote",
		"db:studio": "drizzle-kit studio",
		"db:seed:presets": "node scripts/seed-presets.ts",
		"db:seed:presets:remote": "node scripts/seed-presets.ts --remote",
		"db:setup:local": "pnpm db:migrate:local && pnpm db:seed:presets",
		"db:seed:dev": "node scripts/seed-presets.ts && node scripts/seed-dev.ts"
	},
	"dependencies": {
		"@date-fns/tz": "^1.5.0",
		"@dnd-kit/core": "6.3.1",
		"@dnd-kit/sortable": "10.0.0",
		"@dnd-kit/utilities": "3.2.2",
		"@hookform/resolvers": "^7.0.8",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-query": "^5.108.2",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-start": "1.169.7",
		"better-auth": "^1.7.27",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"drizzle-orm": "^0.45.4",
		"lucide-react": "^1.77.0",
		"next-themes": "^0.4.6",
		"radix-ui": "^1.8.1",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-hook-form": "^7.92.0",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.7.1",
		"tailwindcss": "^4.1.18",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.26.0",
		"@types/node": "^22.10.2",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"drizzle-kit": "^0.31.11",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.2",
		"vite": "^8.0.0",
		"vitest": "^5.1.1",
		"wrangler": "^4.166.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lightningcss",
			"sharp",
			"workerd"
		]
	},
	"packageManager": "pnpm@12.10.1",
	"engines": {
		"node": ">=24"
	}
}
